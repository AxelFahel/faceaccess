# Ambiente e Configuração Geral
APP_ENV=production
LOG_LEVEL=INFO
APP_NAME=FaceAccess
APP_VERSION=0.1.0

# Banco de Dados PostgreSQL
POSTGRES_USER=faceaccess_user
POSTGRES_PASSWORD=SubstituaPorUmaSenhaForte2026!
DATABASE_URL=postgresql+psycopg://faceaccess_user:SubstituaPorUmaSenhaForte2026!@db:5432/faceaccess

# Autenticação e Criptografia
# Gerar chaves aleatórias seguras com: python -c "import os, base64; print(base64.b64encode(os.urandom(32)).decode())"
JWT_SECRET=gerar_chave_jwt_com_pelo_menos_32_caracteres_aleatorios_aqui
AUDIT_HMAC_KEY=gerar_chave_hmac_com_pelo_menos_32_caracteres_aleatorios_aqui
BIOMETRIC_KEYS={"k1": "gerar_chave_aes256_32bytes_base64_aqui"}
BIOMETRIC_ACTIVE_KEY_ID=k1
DATA_ENCRYPTION_KEY=gerar_chave_aes256_32bytes_base64_aqui

# Biometria Local (UniFace)
UNIFACE_CACHE_DIR=/models
BIOMETRIC_ENGINE=uniface
COOKIE_SECURE=false
ENABLE_API_DOCS=true

# Bootstrap Inicial
BOOTSTRAP_ADMIN_EMAIL=admin@faceaccess.com
BOOTSTRAP_ADMIN_PASSWORD=Admin@Secure2026!
